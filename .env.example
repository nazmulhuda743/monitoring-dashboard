# Copy to .env.local for local development. In production set these in
# Vercel → Project → Settings → Environment Variables, then redeploy.
# Without CLICKUP_API_TOKEN the dashboard shows sample data.

# Required: personal API token of Bionda's ClickUp user
# (ClickUp → avatar → Settings → Apps → API Token). Starts with pk_.
CLICKUP_API_TOKEN=

# Optional: workspace id (default: the token's first workspace).
CLICKUP_TEAM_ID=
# Optional: comma-separated space ids that hold projects (default: all spaces).
CLICKUP_SPACE_IDS=
# Optional: what counts as one project: "list" (default) or "folder".
CLICKUP_PROJECT_LEVEL=list
# Optional: tag that marks a task as a decision (default "decision").
CLICKUP_DECISION_TAG=decision
# Optional: max projects shown (default 12).
CLICKUP_MAX_PROJECTS=12
