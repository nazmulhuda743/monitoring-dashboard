# Copy to .env.local for local development. In production set these in
# Vercel → Project → Settings → Environment Variables, then redeploy.
# Without CLICKUP_API_TOKEN the dashboard shows sample data.

# Required: personal API token of Bionda's ClickUp user
# (ClickUp → avatar → Settings → Apps → API Token). Starts with pk_.
CLICKUP_API_TOKEN=

# Optional: workspace id (default: the token's first workspace).
CLICKUP_TEAM_ID=
# Optional: comma-separated space ids that hold projects (default: all spaces).
CLICKUP_SPACE_IDS=
# Optional: what counts as one project: "list" (default) or "folder".
CLICKUP_PROJECT_LEVEL=list
# Optional: tag that marks a task as a decision (default "decision").
CLICKUP_DECISION_TAG=decision
# Optional: max projects shown (default 12).
CLICKUP_MAX_PROJECTS=12

# ---------------- LinkedIn (company page posts + stats) ----------------
# From the LinkedIn developer app → Auth tab, after Community Management API
# is approved. Also add this redirect URL on that Auth tab:
#   https://<your-site>/api/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional: numeric id of the company page (linkedin.com/company/<id>/admin).
# Recommended: only admins of this page can connect.
LINKEDIN_ORGANIZATION_ID=
# Optional: API version YYYYMM (default 202611; each version lives ~1 year).
LINKEDIN_API_VERSION=
# Optional: minutes between LinkedIn refreshes (default 30; dev tier ≈ 500 calls/day).
LINKEDIN_REFRESH_MINUTES=30

# ---------------- Storage (needed for LinkedIn) ----------------
# Vercel → Storage → Upstash (Redis) → connect to the project. Vercel adds
# these automatically (either pair works). Locally a file in .data/ is used.
KV_REST_API_URL=
KV_REST_API_TOKEN=
